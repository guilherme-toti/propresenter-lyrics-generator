# OpenRouter (https://openrouter.ai) powers the "Generate with AI" flow.
OPENROUTER_API_KEY=

# Any model slug available on OpenRouter. Pick one with strong knowledge of song
# lyrics/translations — e.g. openai/gpt-4o, anthropic/claude-3.7-sonnet, google/gemini-2.5-pro.
OPENROUTER_MODEL=openai/gpt-4o

# Sent as the OpenRouter HTTP-Referer header. Set this to your deployed URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
