# OpenRouter (https://openrouter.ai) powers the "Generate with AI" flow.
OPENROUTER_API_KEY=

# Any model slug available on OpenRouter. Pick one with strong knowledge of song
# lyrics/translations — e.g. openai/gpt-4o, anthropic/claude-3.7-sonnet, google/gemini-2.5-pro.
OPENROUTER_MODEL=openai/gpt-4o

# Musixmatch (https://developer.musixmatch.com) is the source of lyrics: a licensed database,
# looked up by title and artist. Without it the app still works — it falls back to asking the
# model to recall the words, which is far less reliable for smaller Brazilian releases.
# Note their terms require the returned copyright notice to be shown and the view to be counted
# wherever the lyrics are displayed; the app does both (see MusixmatchAttribution).
MUSIXMATCH_API_KEY=

# Sent as the OpenRouter HTTP-Referer header. Set this to your deployed URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
