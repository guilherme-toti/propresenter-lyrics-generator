# OpenRouter (https://openrouter.ai) runs the app's few AI calls. Generating a song doesn't ask it
# for lyrics or translations — those come from Musixmatch (see MUSIXMATCH_API_KEY below). It's used for:
#   - "Realinhar com IA": lines up the two editors' text, without translating it;
#   - "Traduzir com IA": translates one side line for line, only when clicked;
#   - language identification, only when the catalogue doesn't tag a picked recording as English or Portuguese;
#   - line classification, when a song opened from the ProPresenter Library has lines the
#     Português/English heuristic can't tell apart.
# Without it the manual flow still works, and so does generation for any recording the catalogue
# tags as English or Portuguese.
OPENROUTER_API_KEY=

# Any model slug available on OpenRouter. Only "Realinhar com IA" and "Traduzir com IA" use it;
# language identification and line classification always run on openai/gpt-4o-mini.
OPENROUTER_MODEL=openai/gpt-4o

# Musixmatch (https://developer.musixmatch.com) is the licensed lyrics database behind catalogue
# search, the picked recording's lyrics, Musixmatch's own translation of them, and "Buscar" on a
# side's card. Without it the catalogue can't be searched: "Criar manualmente" and songs from the
# ProPresenter Library still work.
# Note their terms require the returned copyright notice to be shown and the view to be counted
# wherever the lyrics are displayed; the app does both (see MusixmatchAttribution).
MUSIXMATCH_API_KEY=

# Sent as the OpenRouter HTTP-Referer header, which only labels the app in OpenRouter's dashboard.
# The app is desktop-only (no web deploy), so the default is fine.
NEXT_PUBLIC_APP_URL=http://localhost:3000
